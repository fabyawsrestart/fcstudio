 "custom_css": "@font-face{font-family:'Montserrat';font-style:normal;font-weight:400;font-display:swap;src:url(fc-fonts://montserrat-Regular.woff2) format('woff2')}@font-face{font-family:'Montserrat';font-style:normal;font-weight:500;font-display:swap;src:url(fc-fonts://montserrat-Medium.woff2) format('woff2')}@font-face{font-family:'Montserrat';font-style:normal;font-weight:600;font-display:swap;src:url(fc-fonts://montserrat-SemiBold.woff2) format('woff2')}@font-face{font-family:'Montserrat';font-style:normal;font-weight:700;font-display:swap;src:url(fc-fonts://montserrat-Bold.woff2) format('woff2')}@font-face{font-family:'Montserrat';font-style:normal;font-weight:800;font-display:swap;src:url(fc-fonts://montserrat-ExtraBold.woff2) format('woff2')}h2,h3{text-wrap:balance}p{text-wrap:pretty}.fc-offset img,.fc-offset.e-con{box-shadow:16px 16px 0 var(--fc-sombra)}.fc-offset--verde{--fc-sombra:#168A5B}.fc-offset--cinza{--fc-sombra:#CBD2D9}.fc-borda.e-con{border:1px solid #CBD2D9}@media(max-width:880px){.fc-offset img,.fc-offset.e-con{box-shadow:1.622vw 1.622vw 0 var(--fc-sombra)}.fc-borda.e-con{border-width:.135vw}}@media(max-width:575px){.fc-offset img,.fc-offset.e-con{box-shadow:2.564vw 2.564vw 0 var(--fc-sombra)}.fc-borda.e-con{border-width:.256vw}}::selection{background:#168A5B;color:#fff}:focus-visible{outline:2px solid #168A5B;outline-offset:3px;border-radius:4px}html{scrollbar-color:#168A5B #F6F8F7;accent-color:#168A5B}a{text-underline-offset:.2em}.elementor-button{transition:transform .2s cubic-bezier(.16,1,.3,1),box-shadow .2s}.elementor-button:hover{transform:translateY(-1px)}"
}