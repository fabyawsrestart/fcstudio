 "custom_css": "@font-face{font-family:'Montserrat';font-style:normal;font-weight:400;font-display:swap;src:url(fc-fonts://montserrat-Regular.woff2) format('woff2')}@font-face{font-family:'Montserrat';font-style:normal;font-weight:500;font-display:swap;src:url(fc-fonts://montserrat-Medium.woff2) format('woff2')}@font-face{font-family:'Montserrat';font-style:normal;font-weight:600;font-display:swap;src:url(fc-fonts://montserrat-SemiBold.woff2) format('woff2')}@font-face{font-family:'Montserrat';font-style:normal;font-weight:700;font-display:swap;src:url(fc-fonts://montserrat-Bold.woff2) format('woff2')}@font-face{font-family:'Montserrat';font-style:normal;font-weight:800;font-display:swap;src:url(fc-fonts://montserrat-ExtraBold.woff2) format('woff2')}@font-face{font-family:'Morganite';font-style:normal;font-weight:100 900;font-display:swap;src:url(fc-fonts://morganite-ExtraBold.ttf) format('truetype')}:root{--px:1px}@media(max-width:880px){:root{--px:calc(100vw/740)}}@media(max-width:575px){:root{--px:calc(100vw/390)}}body{background:#050505}h2,h3{text-wrap:balance}p{text-wrap:pretty}.fc-estrelas.e-con{background-image:url(fc-fonts://estrelas.jpg);background-repeat:repeat;background-size:calc(1200*var(--px))}.fc-verde{background:linear-gradient(180deg,#00F000 0%,#00B100 100%);-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent;-webkit-box-decoration-break:clone;box-decoration-break:clone}.fc-display{display:block;font-family:Morganite,\"Arial Narrow\",sans-serif;font-weight:800;font-size:2.7em;line-height:.9;letter-spacing:.005em;margin-top:.06em}.fc-barra .elementor-heading-title{border-left:.055em solid #00D61A;padding-left:.2em}.fc-traco{position:relative;height:calc(12*var(--px))}.fc-traco:before{content:\"\";position:absolute;left:0;top:0;width:calc(12*var(--px));height:calc(12*var(--px));border-radius:50%;background:#00E600;box-shadow:0 0 calc(12*var(--px)) #00E600}.fc-traco:after{content:\"\";position:absolute;left:calc(6*var(--px));right:0;top:calc(5.5*var(--px));height:max(1px,calc(1*var(--px)));background:linear-gradient(90deg,#00D61A,rgba(0,214,26,.15))}.fc-linha-v.e-con{position:relative}.fc-linha-v.e-con:before{content:\"\";position:absolute;left:0;top:0;bottom:calc(6*var(--px));width:max(1px,calc(1*var(--px)));background:linear-gradient(180deg,rgba(0,214,26,.1),#00D61A)}.fc-linha-v.e-con:after{content:\"\";position:absolute;left:calc(-5.5*var(--px));bottom:0;width:calc(12*var(--px));height:calc(12*var(--px));border-radius:50%;background:#00E600;box-shadow:0 0 calc(12*var(--px)) #00E600}.fc-glow.e-con{background:radial-gradient(closest-side at 50% 50%,rgba(170,255,170,.9) 0%,#00E600 30%,rgba(0,190,20,.4) 62%,rgba(0,0,0,0) 100%)}.fc-circulos.e-con{background-image:repeating-radial-gradient(circle at 92% 18%,rgba(0,0,0,0) 0 calc(46*var(--px)),rgba(0,0,0,.07) calc(46*var(--px)) calc(47.5*var(--px)))}.fc-neon .elementor-button{background-image:linear-gradient(180deg,#00E600,#00B100)}.elementor-button{transition:transform .2s cubic-bezier(.16,1,.3,1),box-shadow .2s}.elementor-button:hover{transform:translateY(-1px)}.fc-neon .elementor-button:hover{box-shadow:0 calc(10*var(--px)) calc(30*var(--px)) rgba(0,214,26,.35)}.fc-offset img,.fc-offset.e-con{box-shadow:0 0 0 max(1px,calc(1*var(--px))) rgba(0,214,26,.6),0 0 calc(56*var(--px)) rgba(0,214,26,.18)}.fc-offset--cinza img{box-shadow:0 0 0 max(1px,calc(1*var(--px))) #2A2A2A}.fc-borda.e-con{border:max(1px,calc(1*var(--px))) solid #2A2A2A}.elementor-widget-text-editor strong{color:#fff;font-weight:700}.fc-claro .elementor-widget-text-editor strong{color:#0A0A0A}.elementor-field-group .elementor-field::placeholder{color:#8A8A8A}::selection{background:#00D61A;color:#050505}:focus-visible{outline:2px solid #00E600;outline-offset:3px;border-radius:4px}html{scrollbar-color:#00D61A #050505;accent-color:#00D61A}a{text-underline-offset:.2em}"
